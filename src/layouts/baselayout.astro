---
import Header from "../components/header.astro";
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
const title = Astro.props;
import "../style/main.css";
---

<html lang="en">
  <head>
    <Header title={title} />
  </head>
  <body>
    <section class="main-container">
      <Navbar />
      <slot />
      <Footer />
    </section>
  </body>
</html>
